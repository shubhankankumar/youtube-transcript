{
  "manifest_version": 3,
  "name": "Copy Transcript",
  "version": "2.1.0",
  "description": "One-click copy YouTube video transcripts to your clipboard",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "declarativeNetRequest", "scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "commands": {
    "copy-transcript": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "Command+Shift+Q"
      },
      "description": "Copy YouTube transcript silently"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copy Transcript"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
